[resource]
script = ExtResource("1_r530t")
Title = "Bird Description"
BodyText = "The Western Snowy Plover nests on sandy beaches during the summer. They nest in small, camouflaged dips on the open sand, decorated with small bones, pebbles, and shell fragments. "
metadata/_custom_type_script = "uid://ceqfnmsikiuwm"
